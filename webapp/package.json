{
    "name": "mattermost-channel-reply-webapp",
    "version": "1.1.3",
    "description": "Web app bundle for the Channel Reply Mattermost plugin.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Raidzer/mattermost-reply-tools.git"
    },
