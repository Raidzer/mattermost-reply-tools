        "@mattermost/types": "10.6.0",
        "@types/react": "18.2.64",
        "@types/react-dom": "18.2.19",
        "@vitest/coverage-v8": "2.1.9",
        "babel-loader": "9.1.2",
        "css-loader": "6.11.0",
        "jsdom": "24.1.3",
        "react-dom": "18.2.0",
        "sass": "1.77.8",
        "sass-loader": "13.3.3",
        "style-loader": "3.3.4",
        "typescript": "5.5.4",
        "vitest": "2.1.9",
        "webpack": "5.95.0",
        "webpack-cli": "5.1.4"
